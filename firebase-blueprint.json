{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data stored by authentication UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID from Firebase Authentication"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User verified email address"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user creation"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User document mapped by user authentication UID"
    }
  }
}
